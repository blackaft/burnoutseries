{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "posts.schema.json",
  "title": "Burnout Series Vault Index",
  "type": "object",
  "properties": {
    "updated_at": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/indexItem" }
    }
  },
  "required": ["updated_at", "count", "items"],
  "additionalProperties": false,
  "$defs": {
    "indexItem": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["post"] },
        "source": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "creator": { "type": ["string", "null"] },
        "published": { "type": ["string", "null"], "format": "date-time" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "excerpt": { "type": ["string", "null"] },
        "md_path": { "type": ["string", "null"] },
        "raw_path": { "type": ["string", "null"] }
      },
      "required": ["kind", "source", "title", "creator", "published", "url", "excerpt", "md_path", "raw_path"],
      "additionalProperties": false
    }
  }
}
