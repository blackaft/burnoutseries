{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "excerpts.schema.json",
  "title": "Burnout Series Excerpts Index",
  "type": "object",
  "properties": {
    "updated_at": { "type": "string", "format": "date-time" },
    "base_url": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/excerptItem" }
    }
  },
  "required": ["updated_at", "base_url", "count", "items"],
  "additionalProperties": false,
  "$defs": {
    "excerptItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "excerpt": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" },
        "file": { "type": "string" }
      },
      "required": ["id", "excerpt", "published_at", "file"],
      "additionalProperties": false
    }
  }
}
